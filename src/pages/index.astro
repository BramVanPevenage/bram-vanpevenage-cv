---
import Layout from '../layouts/Layout.astro';
import { getEntry, getCollection, render } from 'astro:content';

// Set static rendering for the CV page to make it super fast
export const prerender = true;

const personalEntry = await getEntry('personal', 'index');
if (!personalEntry) {
  throw new Error('Personal information not found. Make sure to seed src/content/personal/index.json');
}
const personal = personalEntry.data;

const workExperience = await getCollection('workExperience');
const education = await getCollection('education');
const projects = await getCollection('projects');
const skills = await getCollection('skills');

// Sort work experience and education (most recent first)
const sortedWork = workExperience.sort((a, b) => {
  if (a.data.current) return -1;
  if (b.data.current) return 1;
  return b.data.startDate.localeCompare(a.data.startDate);
});

const sortedEducation = education.sort((a, b) => {
  return b.data.startDate.localeCompare(a.data.startDate);
});
---

<Layout title={`${personal.name} | Curriculum Vitae`}>
  <main class="space-y-12">
    <!-- Header Controls / Navigation -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 bg-white p-4 rounded-xl shadow-sm border border-slate-100">
      <div class="text-sm text-slate-500">
        <span>Web CV Template</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={`${import.meta.env.BASE_URL}cv.md`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors border border-indigo-100"
          title="Download/view raw Markdown for AI parsing"
        >
          <span>🤖</span> AI-Parseable Markdown
        </a>
        {import.meta.env.DEV && (
          <a
            href={`${import.meta.env.BASE_URL}keystatic`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors border border-emerald-100"
            title="Edit content with Keystatic CMS"
          >
            <span>✏️</span> Manage CMS
          </a>
        )}
      </div>
    </div>

    <!-- Personal Profile Info -->
    <header class="space-y-6">
      <div class="space-y-2">
        <h1 class="text-4xl font-bold text-slate-900 tracking-tight">{personal.name}</h1>
        <p class="text-xl font-medium text-slate-600">{personal.title}</p>
      </div>

      <!-- Contact Metadata Bar -->
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {personal.location}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <a href={`mailto:${personal.email}`} class="hover:text-slate-900 transition-colors">{personal.email}</a>
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {personal.phone}
        </span>
        {personal.website && (
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
            <a href={personal.website} target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">Portfolio</a>
          </span>
        )}
        {personal.github && (
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            <a href={personal.github} target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">GitHub</a>
          </span>
        )}
        {personal.linkedin && (
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">LinkedIn</a>
          </span>
        )}
      </div>

      <div class="border-t border-slate-200 pt-6">
        <h2 class="text-lg font-semibold text-slate-900 uppercase tracking-wider mb-2">Professional Summary</h2>
        <p class="text-slate-700 leading-relaxed text-justify">{personal.summary}</p>
      </div>
    </header>

    <!-- Skills Section -->
    {skills.length > 0 && (
      <section class="border-t border-slate-200 pt-8 space-y-4">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight uppercase">Skills</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {skills.map(skillGroup => (
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
              <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">{skillGroup.id}</h3>
              <div class="flex flex-wrap gap-2">
                {skillGroup.data.skillsList.split(',').map((skill: string) => (
                  <span class="px-2.5 py-1 text-xs font-medium text-slate-700 bg-slate-100 rounded-md">
                    {skill.trim()}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Work Experience Section -->
    {sortedWork.length > 0 && (
      <section class="border-t border-slate-200 pt-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight uppercase">Work Experience</h2>
        <div class="space-y-8">
          {sortedWork.map(async job => {
            const { Content } = await render(job);
            return (
              <div class="space-y-2">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                  <div>
                    <h3 class="text-lg font-bold text-slate-900">{job.data.position}</h3>
                    <p class="text-md font-medium text-indigo-600">{job.id.replace(/-/g, ' ').toUpperCase()}</p>
                  </div>
                  <div class="text-sm text-slate-500 font-medium">
                    {job.data.startDate} — {job.data.endDate}
                  </div>
                </div>
                <div class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed">
                  <Content />
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Projects Section -->
    {projects.length > 0 && (
      <section class="border-t border-slate-200 pt-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight uppercase">Projects</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {projects.map(async project => {
            const { Content } = await render(project);
            return (
              <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-between h-full space-y-4">
                <div class="space-y-2">
                  <div class="flex justify-between items-start gap-2">
                    <h3 class="text-md font-bold text-slate-900 capitalize">{project.id.replace(/-/g, ' ')}</h3>
                    {project.data.link && (
                      <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-indigo-600 transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                      </a>
                    )}
                  </div>
                  <div class="prose prose-slate text-xs text-slate-600">
                    <Content />
                  </div>
                </div>
                {project.data.technologies && (
                  <div class="flex flex-wrap gap-1.5 pt-2">
                    {project.data.technologies.split(',').map((tech: string) => (
                      <span class="px-2 py-0.5 text-[10px] font-medium text-indigo-700 bg-indigo-50 rounded-md">
                        {tech.trim()}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Education Section -->
    {sortedEducation.length > 0 && (
      <section class="border-t border-slate-200 pt-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-900 tracking-tight uppercase">Education</h2>
        <div class="space-y-6">
          {sortedEducation.map(async edu => {
            const { Content } = await render(edu);
            return (
              <div class="space-y-2">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                  <div>
                    <h3 class="text-lg font-bold text-slate-900">{edu.data.degree} in {edu.data.fieldOfStudy}</h3>
                    <p class="text-md font-medium text-slate-600 capitalize">{edu.id.replace(/-/g, ' ')}</p>
                  </div>
                  <div class="text-sm text-slate-500 font-medium">
                    {edu.data.startDate} — {edu.data.endDate}
                  </div>
                </div>
                <div class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed">
                  <Content />
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}
  </main>
</Layout>
